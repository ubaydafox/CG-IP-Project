{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "g++",
      "args": [
        "-O2",
        "-I${workspaceFolder}/include",
        "-L${workspaceFolder}/lib",
        "${workspaceFolder}/src/colors.cpp",
        "${workspaceFolder}/src/state.cpp",
        "${workspaceFolder}/src/sprites.cpp",
        "${workspaceFolder}/src/audio.cpp",
        "${workspaceFolder}/src/draw.cpp",
        "${workspaceFolder}/src/world.cpp",
        "${workspaceFolder}/src/daynight.cpp",
        "${workspaceFolder}/src/render.cpp",
        "${workspaceFolder}/src/game.cpp",
        "${workspaceFolder}/src/input.cpp",
        "${workspaceFolder}/src/highscore.cpp",
        "${workspaceFolder}/src/main.cpp",
        "-lfreeglut", "-lopengl32", "-lglu32", "-lwinmm",
        "-o", "${workspaceFolder}/ChronoRun.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
